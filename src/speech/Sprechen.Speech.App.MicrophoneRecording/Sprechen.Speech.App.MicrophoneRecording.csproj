<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <GeneratedWebAssetsStamp>$(MSBuildProjectExtensionsPath)generated-web-assets.stamp</GeneratedWebAssetsStamp>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.JSInterop" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sprechen.Speech.App.Contracts\Sprechen.Speech.App.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="package.json;package-lock.json;tsconfig.json;TypeScript/**" />
    <None Include="package.json;package-lock.json;tsconfig.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <TypeScriptInputs Include="package.json;package-lock.json;tsconfig.json;TypeScript/**/*.ts" />
  </ItemGroup>

  <Target Name="RestoreMicrophoneNodeModules" BeforeTargets="GenerateMicrophoneWebAssets" Inputs="package.json;package-lock.json" Outputs="$(MSBuildProjectDirectory)/node_modules/.web-assets.stamp">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="npm ci --no-fund --no-audit" />
    <Touch Files="$(MSBuildProjectDirectory)/node_modules/.web-assets.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="GenerateMicrophoneWebAssets" DependsOnTargets="RestoreMicrophoneNodeModules" Inputs="@(TypeScriptInputs)" Outputs="$(GeneratedWebAssetsStamp)">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="npm run build --silent" />
    <MakeDir Directories="$(MSBuildProjectExtensionsPath)" />
    <Touch Files="$(GeneratedWebAssetsStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="BuildMicrophoneWebAssets" BeforeTargets="ResolveProjectStaticWebAssets;ResolveStaticWebAssets" DependsOnTargets="GenerateMicrophoneWebAssets">
    <ItemGroup>
      <_GeneratedWebAsset Include="wwwroot/js/**/*.js" />
      <Content Remove="@(_GeneratedWebAsset)" />
      <Content Include="@(_GeneratedWebAsset)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    </ItemGroup>
  </Target>
</Project>
