<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sprechen.Forms.IntegrationTests" />
    <InternalsVisibleTo Include="Sprechen.Forms.PlaywrightTests" />
    <InternalsVisibleTo Include="Sprechen.Forms.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\hosting\Sprechen.ServiceDefaults\Sprechen.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\contracts\Sprechen.Contracts.ApiClient\Sprechen.Contracts.ApiClient.csproj" />
    <ProjectReference Include="..\..\contracts\Sprechen.Contracts.FormSurfaces\Sprechen.Contracts.FormSurfaces.csproj" />
    <ProjectReference Include="..\..\contracts\Sprechen.Contracts.MdaFormAccess\Sprechen.Contracts.MdaFormAccess.csproj" />
    <ProjectReference Include="..\..\mda\Sprechen.Mda.Contracts\Sprechen.Mda.Contracts.csproj" />
    <ProjectReference Include="..\..\mda\Sprechen.Mda.Preflight\Sprechen.Mda.Preflight.csproj" />
    <ProjectReference Include="..\..\web\Sprechen.Web.FormSurfaces\Sprechen.Web.FormSurfaces.csproj" />
  </ItemGroup>

  <Target Name="CompileTypeScript" BeforeTargets="Build" Condition="Exists('tsconfig.json')">
    <Exec Command="npm ci --silent" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="Exists('package-lock.json') AND !Exists('node_modules')" />
    <Exec Command="npm run --silent build:ts" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\evaluation-telemetry\Sprechen.EvaluationTelemetry.Api\Sprechen.EvaluationTelemetry.Api.csproj" />
    <ProjectReference Include="..\..\evaluation-telemetry\Sprechen.EvaluationTelemetry.Ingestion\Sprechen.EvaluationTelemetry.Ingestion.csproj" />
    <ProjectReference Include="..\..\evaluation-telemetry\Sprechen.EvaluationTelemetry.JsonlStore\Sprechen.EvaluationTelemetry.JsonlStore.csproj" />
    <Using Include="Sprechen.EvaluationTelemetry.Ingestion" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sprechen.Forms.FileSystem.Tests" />
  </ItemGroup>
</Project>
