{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [ "DOM", "DOM.Iterable", "ES2020" ],
    "module": "ES2020",
    "strict": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "newLine": "lf",
    "rootDir": "./TypeScript",
    "outDir": "./wwwroot/voice-support/js",
    "sourceMap": false
  },
  "include": [ "TypeScript/**/*.ts" ]
}
