{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ConversationStreaming": {
    "ClientInactivityTimeoutMs": 8000
  },
  "DeepgramAudit": {
    "IsEnabled": true,
    "JsonlDirectory": "studydata/deepgram-audit"
  }
}
