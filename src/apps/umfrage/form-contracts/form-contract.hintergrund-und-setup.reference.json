      },
      "severity": "error",
      "code": "study.umfrage.kategorien.required",
      "kind": "required",
      "message": {
        "de": "Mindestens eine Kategorie fehlt noch.",
        "en": "At least one category is still missing.",
        "fr": "Au moins une cat\u00e9gorie manque encore.",
        "es": "Al menos una categor\u00eda todav\u00eda falta.",
        "it": "Almeno una categoria manca ancora."
      },
      "remediation": {
        "de": "Nennen Sie einen oder mehrere Namen nacheinander und sagen Sie dann \u00fcbernehmen.",
        "de@informal": "Nenne einen oder mehrere Namen nacheinander und sag dann \u00fcbernehmen.",
        "en": "Name one or more, one after another, then say accept.",
        "fr": "Nommez-en une ou plusieurs, l\u2019une apr\u00e8s l\u2019autre, puis dites accepter.",
        "fr@informal": "Nommes-en une ou plusieurs, l\u2019une apr\u00e8s l\u2019autre, puis dis accepter.",
        "es": "Nombre una o varias, una tras otra, y luego diga aceptar.",
        "es@informal": "Nombra una o varias, una tras otra, y luego di aceptar.",
        "it": "Ne indichi una o pi\u00f9, una dopo l\u2019altra, poi dica accettare.",
        "it@informal": "Indica una o pi\u00f9, una dopo l\u2019altra, poi di' accettare."
      }
    },
    {
      "constraintId": "study.umfrage.hintergrund-und-setup.quizrundenalter.required",
      "target": {
        "kind": "field",
        "fieldId": "quizrundenalter_field"
      },
      "severity": "error",
      "code": "study.umfrage.quizrundenalter.required",
      "kind": "required",
      "message": {
        "de": "Das Alter der Quizrunde fehlt noch.",
        "en": "The age of the quiz round is still missing.",
        "fr": "L\u2019\u00e2ge de la manche de quiz manque encore.",
        "es": "La antig\u00fcedad de la ronda de quiz todav\u00eda falta.",
        "it": "L\u2019et\u00e0 del turno di quiz manca ancora."
      },
      "remediation": {
        "de": "Die Zeitspannen sind: weniger als ein Jahr, ein bis drei Jahre, vier bis sechs Jahre, sieben bis zehn Jahre, mehr als zehn Jahre.",
        "en": "The ranges are: less than one year, one to three years, four to six years, seven to ten years, more than ten years.",
        "fr": "Les dur\u00e9es sont : moins d\u2019un an, un \u00e0 trois ans, quatre \u00e0 six ans, sept \u00e0 dix ans, plus de dix ans.",
        "es": "Los intervalos son: menos de un a\u00f1o, de uno a tres a\u00f1os, de cuatro a seis a\u00f1os, de siete a diez a\u00f1os, m\u00e1s de diez a\u00f1os.",
        "it": "Gli intervalli sono: meno di un anno, da uno a tre anni, da quattro a sei anni, da sette a dieci anni, pi\u00f9 di dieci anni."
      }
    },
    {
      "constraintId": "study.umfrage.hintergrund-und-setup.uebungstreffen.required",
      "target": {
        "kind": "field",
        "fieldId": "uebungstreffen_field"
      },
      "severity": "error",
      "code": "study.umfrage.uebungstreffen.required",
      "kind": "required",
      "message": {
        "de": "Die Angabe zu den \u00dcbungstreffen fehlt noch.",
        "en": "The entry on practice meetings is still missing.",
        "fr": "L\u2019indication sur les s\u00e9ances d\u2019entra\u00eenement manque encore.",
        "es": "El dato sobre los ensayos todav\u00eda falta.",
        "it": "L\u2019indicazione sugli allenamenti manca ancora."
      },
      "remediation": {
        "de": "Die Angaben sind: t\u00e4glich, mehrmals pro Woche, w\u00f6chentlich, seltener.",
        "en": "The options are: daily, several times a week, weekly, less often.",
        "fr": "Les r\u00e9ponses sont : quotidiennement, plusieurs fois par semaine, chaque semaine, plus rarement.",
        "es": "Las opciones son: a diario, varias veces por semana, semanalmente, con menos frecuencia.",
        "it": "Le opzioni sono: ogni giorno, pi\u00f9 volte alla settimana, ogni settimana, meno spesso."
      }
    },
    {
      "constraintId": "study.umfrage.hintergrund-und-setup.zusatzpunkte.required",
