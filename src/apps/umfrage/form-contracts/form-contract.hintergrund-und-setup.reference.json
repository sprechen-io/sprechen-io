  "rules": [
    {
      "ruleId": "hauptpreis-sichtbarkeit-init",
      "scope": "onInit",
      "when": {
        "kind": "equals",
        "left": {
          "kind": "var",
          "variableId": "siegerehrung"
        },
        "right": {
          "kind": "const",
          "value": true
        }
      },
      "then": [
        {
          "kind": "setVisible",
          "target": {
            "kind": "fieldGroup",
            "fieldGroupId": "hauptpreis"
          },
          "value": true
        }
      ],
      "else": [
        {
          "kind": "setVisible",
          "target": {
            "kind": "fieldGroup",
            "fieldGroupId": "hauptpreis"
          },
          "value": false
        },
        {
          "kind": "clearValue",
          "variableId": "hauptpreis"
        }
      ]
    },
    {
      "ruleId": "hauptpreis-sichtbarkeit-aenderung",
      "scope": "onValueChanged",
      "when": {
        "kind": "equals",
        "left": {
          "kind": "var",
          "variableId": "siegerehrung"
        },
        "right": {
          "kind": "const",
          "value": true
        }
      },
      "then": [
        {
          "kind": "setVisible",
          "target": {
            "kind": "fieldGroup",
            "fieldGroupId": "hauptpreis"
          },
          "value": true
        }
      ],
      "else": [
        {
          "kind": "setVisible",
          "target": {
            "kind": "fieldGroup",
            "fieldGroupId": "hauptpreis"
          },
          "value": false
        },
        {
          "kind": "clearValue",
          "variableId": "hauptpreis"
        }
      ]
    }
  ],
  "constraints": [
    {
      "constraintId": "study.umfrage.hintergrund-und-setup.kategorien.required",
      "target": {
        "kind": "field",
