<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sprechen.Voice</RootNamespace>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sprechen.Voice.Tests" />
    <InternalsVisibleTo Include="Sprechen.Voice.FileSystem.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Content/**/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\speech\Sprechen.Speech.ModelRuntime\Sprechen.Speech.ModelRuntime.csproj" />
    <ProjectReference Include="..\Sprechen.Voice.App\Sprechen.Voice.App.csproj" />
    <ProjectReference Include="..\..\web\Sprechen.Web.HostSupport\Sprechen.Web.HostSupport.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.7" />
  </ItemGroup>

</Project>
