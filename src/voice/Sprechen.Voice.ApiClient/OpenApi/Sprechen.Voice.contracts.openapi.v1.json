{
  "openapi": "3.0.4",
  "info": {
    "title": "Sprechen.Voice API",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:5087/"
    }
  ],
  "paths": {
    "/version": {
      "get": {
        "tags": [
          "ApplicationVersionEndpointHandler"
        ],
        "operationId": "GetApplicationVersion",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationVersionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/contracts/{relativePath}": {
      "get": {
        "tags": [
          "MDA Contracts"
        ],
        "operationId": "ProxyMdaContractArtifact",
        "parameters": [
          {
            "name": "relativePath",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApplicationVersionResponse": {
        "required": [
          "displayVersion",
          "informationalVersion",
          "assemblyVersion",
          "sourceRevision",
          "shortSourceRevision"
        ],
        "type": "object",
        "properties": {
          "displayVersion": {
            "type": "string"
          },
          "informationalVersion": {
            "type": "string"
          },
          "assemblyVersion": {
            "type": "string"
          },
          "sourceRevision": {
            "type": "string",
            "nullable": true
          },
          "shortSourceRevision": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "ApplicationVersionEndpointHandler"
    },
    {
      "name": "MDA Contracts"
    }
  ]
}
