@implements IDisposable
@inject IWakeWordSettingsWorkflow WakeWordSettingsWorkflow
@inject IUserLanguageState UserLanguageState

<section class="card card-body">
    <h2 class="h5">@Copy.VoiceActivation.GetTitle(_state.SelectedIsoCode)</h2>

    <p class="text-body-secondary mb-0">
        @Copy.VoiceActivation.GetIntro(_state.SelectedIsoCode)
    </p>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-warning mt-3 mb-0" role="alert">@_error</div>
    }

    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <div class="alert alert-success mt-3 mb-0" role="status">@_status</div>
    }

    <div class="mt-3">
        <h3 class="h6">@Copy.VoiceActivation.GetModeledDefaultsTitle(_state.SelectedIsoCode)</h3>
        @if (!_loaded)
        {
            <div class="text-body-secondary small">@Copy.General.GetLoadingText(_state.SelectedIsoCode)</div>
        }
        else if (_state.DefaultWakeWordActivationForms.Length == 0)
        {
            <div class="text-body-secondary small">@Copy.VoiceActivation.GetNoWakeWords(_state.SelectedIsoCode)</div>
        }
        else
        {
                <div class="small text-body-secondary mb-2">@Copy.General.GetSessionLanguageSummary(_state.SelectedIsoCode, _state.SelectedIsoCode)</div>
            <ul class="mb-0">
                @foreach (var word in _state.DefaultWakeWordActivationForms)
                {
                    <li>@word</li>
                }
            </ul>
        }
    </div>

    <div class="mt-3">
        <h3 class="h6">@Copy.VoiceActivation.GetLocalOverrideTitle(_state.SelectedIsoCode)</h3>
        <label class="form-label" for="wakewords-editor">
            @Copy.VoiceActivation.GetLocalOverrideHelp(_state.SelectedIsoCode)
        </label>
        <textarea id="wakewords-editor"
                  class="form-control"
                  rows="5"
                  disabled="@(!IsInteractive)"
                  @bind-value="_editorText"
                  @bind-value:event="oninput"></textarea>

        <div class="mt-2 d-flex gap-2">
            <button id="wakewords-save"
                    type="button"
                    class="btn btn-primary"
                    disabled="@(!IsInteractive)"
                    @onclick="SaveAsync">
                @Copy.VoiceActivation.GetSave(_state.SelectedIsoCode)
            </button>
            <button id="wakewords-reset"
                    type="button"
                    class="btn btn-outline-secondary"
                    disabled="@(!IsInteractive)"
                    @onclick="ResetAsync">
                @Copy.VoiceActivation.GetReset(_state.SelectedIsoCode)
            </button>
        </div>
    </div>

    <div class="mt-3">
        <h3 class="h6">@Copy.SpeechReview.GetTitle(_state.SelectedIsoCode)</h3>
        <p class="text-body-secondary mb-2">
            @Copy.SpeechReview.GetIntro(_state.SelectedIsoCode)
        </p>

        <button id="wakewords-speech-setup"
                type="button"
                class="btn btn-outline-primary"
                disabled="@(!IsInteractive)"
                @onclick="RunSpeechSetupAsync">
            @Copy.SpeechReview.GetRun(_state.SelectedIsoCode)
        </button>
    </div>
</section>

@code {
    [Microsoft.AspNetCore.Components.Parameter]
    public string? PreferredIsoCode { get; set; }

    private CancellationTokenSource? _loadCts;
    private bool _isBusy;
    private bool _loaded;
    private string? _error;
    private string? _status;
    private WakeWordConfigurationState _state = new(
        VoiceInterfaceModelCatalog.DefaultLanguage,
        [],
        [],
        string.Empty);
    private string _editorText = string.Empty;
    private string? _lastPreferredIsoCode;
    private VoiceSettingsCopy Copy { get; } = new();

    private bool IsInteractive => _loaded && !_isBusy;

    protected override async Task OnInitializedAsync()
    {
        _lastPreferredIsoCode = NormalizePreferredIsoCode(PreferredIsoCode);
        UserLanguageState.SelectedLanguageChanged += OnSelectedLanguageChanged;
        await ReloadAsync().ConfigureAwait(false);
    }

    protected override Task OnParametersSetAsync()
    {
        var normalizedPreferredIsoCode = NormalizePreferredIsoCode(PreferredIsoCode);
        if (_loadCts is null
            || string.Equals(_lastPreferredIsoCode, normalizedPreferredIsoCode, StringComparison.Ordinal))
        {
            return Task.CompletedTask;
        }

        _lastPreferredIsoCode = normalizedPreferredIsoCode;
        return ReloadAsync();
    }

    private async Task LoadAsync(CancellationToken cancellationToken)
    {
        _error = null;
        _status = null;

        try
        {
            ApplyState(
                await WakeWordSettingsWorkflow
                    .LoadWakeWordConfigurationAsync(_lastPreferredIsoCode, cancellationToken)
                    .ConfigureAwait(false));
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loaded = true;
        }
    }

    private void OnSelectedLanguageChanged(string ignoredIsoCode)
    {
        _ = InvokeAsync(ReloadAsync);
    }

    private async Task SaveAsync()
    {
        if (!_loaded)
        {
            return;
        }

        _error = null;
        _status = null;
        _isBusy = true;

        try
        {
            ApplyState(
                await WakeWordSettingsWorkflow
                    .SaveWakeWordConfigurationAsync(_editorText, _lastPreferredIsoCode, CancellationToken.None)
                    .ConfigureAwait(false));
            _status = Copy.VoiceActivation.GetSaveSuccess(_state.SelectedIsoCode);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ResetAsync()
    {
        if (!_loaded)
        {
            return;
        }

        _error = null;
        _status = null;
        _isBusy = true;

        try
        {
            ApplyState(
                await WakeWordSettingsWorkflow
                    .ResetWakeWordConfigurationAsync(_lastPreferredIsoCode, CancellationToken.None)
                    .ConfigureAwait(false));
            _status = Copy.VoiceActivation.GetResetSuccess(_state.SelectedIsoCode);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RunSpeechSetupAsync()
    {
        if (!_loaded)
        {
            return;
        }

        _error = null;
        _status = null;
        _isBusy = true;

        try
        {
            ApplyState(await WakeWordSettingsWorkflow.RunWakeWordSpeechSetupAsync(
                preferredIsoCode: _lastPreferredIsoCode,
                cancellationToken: CancellationToken.None).ConfigureAwait(false));
            _status = Copy.SpeechReview.GetSuccess(_state.SelectedIsoCode);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ApplyState(WakeWordConfigurationState state)
    {
        _state = state ?? throw new ArgumentNullException(nameof(state));
        _editorText = state.EditorText;
    }

    private async Task ReloadAsync()
    {
        var loadCts = ResetLoadCancellationTokenSource();
        _loaded = false;
        await LoadAsync(loadCts.Token).ConfigureAwait(false);
        await InvokeAsync(StateHasChanged);
    }

    private CancellationTokenSource ResetLoadCancellationTokenSource()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        return _loadCts;
    }

    private static string? NormalizePreferredIsoCode(string? isoCode)
    {
        return IsoCode.TryNormalizeIso6391(isoCode);
    }

    public void Dispose()
    {
        UserLanguageState.SelectedLanguageChanged -= OnSelectedLanguageChanged;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }
}
