@implements IDisposable
@inject IUserLanguageState UserLanguageState

<nav class="nav flex-column nav-menu">
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
            <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @Copy.Chrome.GetHomeTitle(UserLanguageState.SelectedIsoCode)
        </NavLink>
    </div>

    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/language-tester">
            <span class="bi bi-soundwave" aria-hidden="true"></span> @Copy.Chrome.GetLanguageTesterTitle(UserLanguageState.SelectedIsoCode)
        </NavLink>
    </div>

    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/settings">
            <span class="bi bi-gear" aria-hidden="true"></span> @Copy.Chrome.GetSettingsNavLabel(UserLanguageState.SelectedIsoCode)
        </NavLink>
    </div>
</nav>

@code {
    private VoiceSettingsCopy Copy { get; } = new();

    protected override void OnInitialized()
    {
        UserLanguageState.SelectedLanguageChanged += OnDisplayLanguageChanged;
    }

    private void OnDisplayLanguageChanged(string isoCode)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UserLanguageState.SelectedLanguageChanged -= OnDisplayLanguageChanged;
    }
}
