      "valueType": {
        "kind": "integer",
        "min": "achtzehn"
      },
      "expectedRules": [
        {
          "constraintId": "valueType.min",
          "code": "form.valueType.invalid",
          "severity": "error",
          "ruleKind": "min",
          "boundName": "min",
          "bound": "achtzehn"
        }
      ]
    },
    {
      "case": "a whole-number field whose type states no bound states no rule",
      "valueType": {
        "kind": "integer"
