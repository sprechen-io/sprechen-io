  "enforcedRuleProjectionCases": [
    {
      "case": "a blocking rule reaches the surface and the surface carries it under that rule",
      "statedRules": [
        {
          "constraintId": "postalCodeShape",
          "ruleKind": "pattern",
          "severity": "error",
          "pattern": "^[0-9]{5}$"
        }
      ],
      "expectedCarried": [
        {
          "side": "pattern",
          "constraintId": "postalCodeShape",
          "pattern": "^[0-9]{5}$"
        }
      ]
    },
    {
      "case": "an advisory rule does not reach the surface, so the surface does not reject a value the contract only advises against",
      "statedRules": [
        {
          "constraintId": "postalCodeShape",
          "ruleKind": "pattern",
          "severity": "warning",
          "pattern": "^[0-9]{5}$"
        }
      ],
      "expectedCarried": []
    },
    {
      "case": "an informational rule does not reach the surface either",
      "statedRules": [
        {
          "constraintId": "shortHint",
          "ruleKind": "minLength",
          "severity": "info",
          "bound": 4
        }
      ],
      "expectedCarried": []
    },
    {
      "case": "an advisory required rule does not make the field required on the surface",
      "statedRules": [
        {
          "constraintId": "pleaseFill",
          "ruleKind": "required",
          "severity": "warning"
        }
      ],
      "expectedCarried": []
    },
    {
      "case": "a blocking required rule makes the field required on the surface under that rule",
      "statedRules": [
        {
          "constraintId": "mustFill",
          "ruleKind": "required",
          "severity": "error"
        }
      ],
      "expectedCarried": [
        {
          "side": "required",
          "constraintId": "mustFill"
        }
      ]
    },
    {
      "case": "two blocking shortest-length rules both hold, and the surface carries the longer of the two shortest lengths",
      "statedRules": [
        {
          "constraintId": "atLeastThree",
          "ruleKind": "minLength",
          "severity": "error",
          "bound": 3
        },
        {
