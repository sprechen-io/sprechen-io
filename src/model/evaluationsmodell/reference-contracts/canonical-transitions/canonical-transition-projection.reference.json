{
  "$schema": "../../schemas/canonical-transition-projection.schema.json",
  "artifactId": "canonical-transition-projection",
  "description": "The authored truth table of the canonical transition projection, taken from the study event specification. An interaction step is exactly one canonical business state change, so the step metric is only comparable between the two conditions if both channels project identically - this table is what proves they do. Written by hand rather than generated, so the table stays independent of the implementations it checks.",
  "cases": [
    {
      "case": "a focus change takes a new field target",
      "event": "focus_change",
      "input": {
        "fieldId": "contactEmail"
      },
      "expected": [
        {
          "canonicalClass": "field_target_changed",
          "scope": "field",
          "objectId": "contactEmail",
          "resultingState": "targeted"
        }
      ]
    },
    {
      "case": "a navigation change that moves the field target only",
      "event": "navigation_changed",
      "input": {
        "fieldId": "contactEmail",
        "fieldGroupId": null
      },
      "expected": [
        {
          "canonicalClass": "field_target_changed",
          "scope": "field",
          "objectId": "contactEmail",
          "resultingState": "targeted"
        }
      ]
    },
    {
      "case": "a navigation change that moves the field group target only",
      "event": "navigation_changed",
      "input": {
        "fieldId": null,
        "fieldGroupId": "contact"
      },
      "expected": [
        {
          "canonicalClass": "field_group_target_changed",
          "scope": "field_group",
          "objectId": "contact",
          "resultingState": "targeted"
        }
      ]
    },
    {
      "case": "a navigation change that moves both target levels yields two transitions",
      "event": "navigation_changed",
      "input": {
        "fieldId": "contactEmail",
        "fieldGroupId": "contact"
      },
      "expected": [
        {
          "canonicalClass": "field_target_changed",
          "scope": "field",
          "objectId": "contactEmail",
          "resultingState": "targeted"
        },
        {
          "canonicalClass": "field_group_target_changed",
          "scope": "field_group",
          "objectId": "contact",
          "resultingState": "targeted"
        }
      ]
    },
    {
      "case": "a confirmed value change never carries the value itself",
      "event": "value_change",
      "input": {
        "fieldId": "contactEmail"
      },
      "expected": [
        {
          "canonicalClass": "confirmed_field_value_changed",
          "scope": "field",
          "objectId": "contactEmail",
          "resultingState": "confirmed_changed"
        }
      ]
    },
    {
      "case": "a field that became complete",
      "event": "field_completion_changed",
      "input": {
        "fieldId": "contactEmail",
        "completed": true
      },
      "expected": [
        {
          "canonicalClass": "field_completion_changed",
          "scope": "field",
          "objectId": "contactEmail",
          "resultingState": "complete"
        }
      ]
    },
    {
      "case": "a field that became incomplete again",
      "event": "field_completion_changed",
      "input": {
        "fieldId": "contactEmail",
        "completed": false
      },
      "expected": [
        {
          "canonicalClass": "field_completion_changed",
          "scope": "field",
          "objectId": "contactEmail",
          "resultingState": "incomplete"
        }
      ]
    },
    {
      "case": "a field group that became complete",
      "event": "field_group_completion_changed",
      "input": {
        "fieldGroupId": "contact",
        "completed": true
      },
      "expected": [
        {
          "canonicalClass": "field_group_completion_changed",
          "scope": "field_group",
          "objectId": "contact",
          "resultingState": "complete"
        }
      ]
    },
    {
      "case": "a field group that became incomplete again",
      "event": "field_group_completion_changed",
      "input": {
        "fieldGroupId": "contact",
        "completed": false
      },
      "expected": [
        {
          "canonicalClass": "field_group_completion_changed",
          "scope": "field_group",
          "objectId": "contact",
          "resultingState": "incomplete"
        }
      ]
    },
    {
      "case": "a manual field target uses the same complete transition language",
      "event": "manual_step",
      "input": {
        "canonicalClass": "field_target_changed",
        "scope": "field",
        "objectId": "contactEmail",
        "resultingState": "targeted"
      },
      "expected": [
        {
          "canonicalClass": "field_target_changed",
          "scope": "field",
          "objectId": "contactEmail",
          "resultingState": "targeted"
        }
      ]
    },
    {
      "case": "a manual field-group target uses the same complete transition language",
      "event": "manual_step",
      "input": {
        "canonicalClass": "field_group_target_changed",
        "scope": "field_group",
        "objectId": "contact",
        "resultingState": "targeted"
      },
      "expected": [
        {
          "canonicalClass": "field_group_target_changed",
          "scope": "field_group",
          "objectId": "contact",
          "resultingState": "targeted"
        }
      ]
    },
    {
      "case": "a manual confirmed value change uses the same complete transition language",
      "event": "manual_step",
      "input": {
        "canonicalClass": "confirmed_field_value_changed",
        "scope": "field",
        "objectId": "contactEmail",
        "resultingState": "confirmed_changed"
      },
      "expected": [
        {
          "canonicalClass": "confirmed_field_value_changed",
          "scope": "field",
          "objectId": "contactEmail",
          "resultingState": "confirmed_changed"
        }
      ]
    },
    {
      "case": "a manual field completion uses the same complete transition language",
      "event": "manual_step",
      "input": {
        "canonicalClass": "field_completion_changed",
        "scope": "field",
        "objectId": "contactEmail",
        "resultingState": "complete"
      },
      "expected": [
        {
          "canonicalClass": "field_completion_changed",
          "scope": "field",
          "objectId": "contactEmail",
          "resultingState": "complete"
        }
      ]
    },
    {
      "case": "a manual field-group completion uses the same complete transition language",
      "event": "manual_step",
      "input": {
        "canonicalClass": "field_group_completion_changed",
        "scope": "field_group",
        "objectId": "contact",
        "resultingState": "incomplete"
      },
      "expected": [
        {
          "canonicalClass": "field_group_completion_changed",
          "scope": "field_group",
          "objectId": "contact",
          "resultingState": "incomplete"
        }
      ]
    },
    {
      "case": "the task bracket carries no state change",
      "event": "task_start",
      "input": {},
      "expected": []
    },
    {
      "case": "a validation error is a diagnostic line, not a step",
      "event": "validation_error_opened",
      "input": {},
      "expected": []
    },
    {
      "case": "a status snapshot is not a step",
      "event": "status_snapshot",
      "input": {},
      "expected": []
    },
    {
      "case": "a navigation with no current field names the placeholder, which is not an object",
      "event": "navigation_changed",
      "input": {
        "fieldId": "n/a",
        "fieldGroupId": "contact"
      },
      "expected": [
        {
          "canonicalClass": "field_group_target_changed",
          "scope": "field_group",
          "objectId": "contact",
          "resultingState": "targeted"
        }
      ]
    },
    {
      "case": "a focus change on the placeholder projects nothing rather than a phantom object",
      "event": "focus_change",
      "input": {
        "fieldId": "n/a"
      },
      "expected": []
    }
  ],
