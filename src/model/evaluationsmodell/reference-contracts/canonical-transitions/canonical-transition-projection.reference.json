              "canonicalClass": "field_group_target_changed",
              "scope": "field_group",
              "objectId": "group-a",
              "resultingState": "targeted"
            }
          ],
          "expectedStateVersion": 1,
          "expectedAdoptedTransitions": [
            {
              "canonicalClass": "field_target_changed",
              "scope": "field",
              "objectId": "field-a",
              "resultingState": "targeted"
            },
            {
              "canonicalClass": "field_group_target_changed",
              "scope": "field_group",
              "objectId": "group-a",
              "resultingState": "targeted"
            }
          ],
          "expectedDelta": [
            {
              "canonicalClass": "field_group_target_changed",
              "scope": "field_group",
              "objectId": "group-a",
              "resultingState": "targeted"
            }
          ]
        },
        {
          "event": "focus_change",
          "priorStateVersion": 1,
          "priorAdoptedTransitions": [
            {
              "canonicalClass": "field_target_changed",
              "scope": "field",
