          ],
          "expectedStateVersion": 2,
          "expectedAdoptedTransitions": [
            {
              "canonicalClass": "field_target_changed",
              "scope": "field",
              "objectId": "field-b",
              "resultingState": "targeted"
            },
            {
              "canonicalClass": "field_group_target_changed",
              "scope": "field_group",
              "objectId": "group-a",
              "resultingState": "targeted"
            }
          ],
          "expectedDelta": [
            {
              "canonicalClass": "field_target_changed",
              "scope": "field",
              "objectId": "field-b",
              "resultingState": "targeted"
            }
          ]
        },
        {
          "event": "navigation_changed",
          "priorStateVersion": 2,
          "priorAdoptedTransitions": [
            {
              "canonicalClass": "field_target_changed",
              "scope": "field",
