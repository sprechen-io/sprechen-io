@page "/"
@inject SchemaTextLoader Loader

<PageTitle>MDA Example Composer</PageTitle>

<h3>MDA Example Composer</h3>

@if (!Loader.IsLoaded)
{
    <LoadingSpinner Message="@($"Lade {ComposerRootCatalog.All.Count} Root-Schemas und Referenz-Contracts…")" />
}
else
{
    <p class="text-muted">
        @Loader.ParsedSchemas.Count Basisschemas geladen,
        @Loader.ReferenceContracts.Count Reference-Contracts verfügbar.
    </p>

    <div class="mb-3">
        <input type="text" class="form-control" placeholder="Schema suchen…"
               @oninput="e => _filter = e.Value?.ToString() ?? string.Empty" />
    </div>

    <div class="row">
        @foreach (var (area, schemas) in ComposerRootCatalog.ByModelArea)
        {
            var filtered = schemas.Where(s => MatchesFilter(s)).ToList();
            @if (filtered.Count > 0)
            {
                <div class="col-md-4 mb-3">
                    <div class="card">
                        <div class="card-header"><strong>@area</strong></div>
                        <ul class="list-group list-group-flush">
                            @foreach (var schema in filtered)
                            {
                                var isLoaded = Loader.ParsedSchemas.ContainsKey(schema.FileName);
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <a href="composer/@schema.FileName">@schema.DisplayName</a>
                                    @if (isLoaded)
                                    {
                                        <span class="badge bg-success">✓</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">—</span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        }
    </div>

    @if (Loader.EnumRegistry.GetSchemaEnums().Count > 0)
    {
        <h4 class="mt-4">Erkannte Enums</h4>
        <div class="row">
            @foreach (var e in Loader.EnumRegistry.GetSchemaEnums().Take(12))
            {
                <div class="col-md-3 mb-2">
                    <div class="card card-body p-2">
                        <strong class="small">@e.Name</strong>
                        <small class="text-muted text-truncate" title="@string.Join(", ", e.Values)">
                            @string.Join(", ", e.Values)
                        </small>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private string _filter = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Loader.LoadAllAsync();
    }

    private bool MatchesFilter(ComposerRootSchemaInfo schema) => new ComposerSchemaFilter(_filter).Matches(schema);
}
